<script>
    // Countdown Timer
    let totalSeconds = 8 * 60 + 51;

    function updateCountdown() {
        const minutes = Math.floor(totalSeconds / 60);
        const seconds = totalSeconds % 60;
        const formattedTime = `${String(minutes).padStart(2, '0')}:${String(seconds).padStart(2, '0')}`;
        
        const topTimer = document.getElementById('countdown');
        const bottomTimer = document.getElementById('countdown-bottom');
        
        if (topTimer) topTimer.innerText = formattedTime;
        if (bottomTimer) bottomTimer.innerText = formattedTime;

        if (totalSeconds > 0) {
            totalSeconds--;
        }
    }

    setInterval(updateCountdown, 1000);

    // FAQ Toggle accordion
    function toggleFaq(element) {
        const answer = element.nextElementSibling;
        const icon = element.querySelector('i');
        
        if (answer.classList.contains('hidden')) {
            answer.classList.remove('hidden');
            icon.classList.remove('fa-chevron-down');
            icon.classList.add('fa-chevron-up');
            element.classList.add('bg-blue-50', 'border-blue-200');
        } else {
            answer.classList.add('hidden');
            icon.classList.remove('fa-chevron-up');
            icon.classList.add('fa-chevron-down');
            element.classList.remove('bg-blue-50', 'border-blue-200');
        }
    }

    // Modal Controller Functions
    const modalContainer = document.getElementById('modal-container');
    const modalPix = document.getElementById('modal-pix');
    const modalProcessing = document.getElementById('modal-processing');
    const modalApproved = document.getElementById('modal-approved');

    function openPixModal() {
        modalContainer.classList.remove('hidden');
        modalPix.classList.remove('hidden');
        modalProcessing.classList.add('hidden');
        modalApproved.classList.add('hidden');
    }

    function closeModal() {
        modalContainer.classList.add('hidden');
        modalPix.classList.add('hidden');
        modalProcessing.classList.add('hidden');
        modalApproved.classList.add('hidden');
    }

    let redirectTimer = null;

    function startProcessing() {
        const pixKey = document.getElementById('pix-key-input').value.trim();
        if(!pixKey) {
            alert('Por favor, informe a sua chave PIX para prosseguir.');
            return;
        }

        modalPix.classList.add('hidden');
        modalProcessing.classList.remove('hidden');

        // Simulate step-by-step progress
        setTimeout(() => {
            document.getElementById('step-2').className = "flex items-center gap-2.5 text-green-600 font-semibold";
            document.getElementById('icon-2').className = "fa-solid fa-circle-check text-sm";
            document.getElementById('progress-bar').style.width = "75%";
            document.getElementById('progress-percent').innerText = "75%";
        }, 1200);

        setTimeout(() => {
            document.getElementById('step-3').className = "flex items-center gap-2.5 text-green-600 font-semibold";
            document.getElementById('icon-3').className = "fa-solid fa-circle-check text-sm";
            document.getElementById('progress-bar').style.width = "100%";
            document.getElementById('progress-percent').innerText = "100%";
        }, 2400);

        setTimeout(() => {
            modalProcessing.classList.add('hidden');
            modalApproved.classList.remove('hidden');
            
            // Start 5-second automatic redirection countdown
            let secondsLeft = 5;
            const counterSpan = document.getElementById('redirect-countdown');
            
            if (redirectTimer) clearInterval(redirectTimer);
            
            redirectTimer = setInterval(() => {
                secondsLeft--;
                if (counterSpan) counterSpan.innerText = secondsLeft;
                
                if (secondsLeft <= 0) {
                    clearInterval(redirectTimer);
                    window.location.href = 'https://pay.kirvano.com/39a660d5-78e7-48f5-93c6-6bc4104e79db';
                }
            }, 1000);
        }, 3200);
    }

    // Close modal on background click
    modalContainer.addEventListener('click', (e) => {
        if(e.target === modalContainer) {
            closeModal();
            if(redirectTimer) clearInterval(redirectTimer);
        }
    });
</script>
